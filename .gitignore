.Rproj.user
.Rhistory
.RData
.Ruserdata

# macOS metadata files
.DS_Store
**/.DS_Store

# Windows metadata files
Thumbs.db
desktop.ini

# Editor/IDE files
*.swp
*.swo
*~
.vscode/
.idea/

# Jupyter notebook checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python cache (if using Python with Quarto)
__pycache__/
*.pyc
*.pyo

/.quarto/

# Quarto freeze directory (contains cached computation results)
# This can become very large with PCA/t-SNE/UMAP on MNIST data
_freeze/

# Quarto/knitr cache directories
*_cache/
**/*_cache/

# Note: docs/ is NOT ignored - it's needed for GitHub Pages

# Large data files
*.rdb
*.rdx
*.rds
*.RData
*.rda

# Large figures that may be generated
*.png.large
*.pdf.large
